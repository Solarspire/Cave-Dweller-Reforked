{
  "schemaVersion": 1,
  "id": "cave_dweller",
  "version": "${version}",
  "name": "Cave Dweller Reforked",
  "description": "Modern multi-loader port of Cadentem's Cave Dweller 1.6.4",
  "authors": [
    "Cadentem",
    "SolarSpire"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.cadentem.cave_dweller.fabric.CaveDwellerFabric"
